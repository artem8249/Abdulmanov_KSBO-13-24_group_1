{
    "model": {
        "architecture": "MLP",
        "hidden_dims": [
            512,
            256,
            128
        ],
        "dropout_p": 0.0,
        "use_batchnorm": true
    },
    "training": {
        "optimizer": "Adam",
        "learning_rate": 0.001,
        "criterion": "CrossEntropyLoss",
        "epochs": 50,
        "early_stopping": {
            "patience": 4,
            "min_delta": 0.0005
        }
    },
    "seed": 42,
    "dataset": "EMNIST"
}